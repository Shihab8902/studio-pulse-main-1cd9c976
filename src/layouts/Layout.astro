---
import { ClientRouter } from "astro:transitions";
import "bulma/css/bulma.min.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

export interface Props {
    title: string;
    description?: string;
    currentPage?: string;
}

const { title, description, currentPage } = Astro.props;

const metaDescription =
    description ??
    "Studio Pulse — Full-service communication agency. Brand strategy, creative direction, digital, and content.";
---

<!doctype html>
<html lang="en" data-jc-id="0JMYWQ">
    <head data-jc-id="0JMYUZ">
        <meta charset="utf-8" data-jc-id="0JMYTE"/>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" data-jc-id="0JMY8N"/>
        <meta name="viewport" content="width=device-width" data-jc-id="0JMY2N"/>
        <meta name="description" content={metaDescription} data-jc-id="0JMXFC"/>
        <meta name="generator" content={Astro.generator} data-jc-id="0JMWS1"/>
        <link rel="preconnect" href="https://fonts.googleapis.com" data-jc-id="0JMWMV"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin data-jc-id="0JMVYR"/>
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
        data-jc-id="GWUPU8"/>
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
            media="print"
            onload="this.media='all'"
        data-jc-id="GWUOB6"/>
        <title data-jc-id="GWUM6H">{title} — Studio Pulse</title>
        <script is:inline>
            const stored = localStorage.getItem("theme");
            const prefersDark = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            if (stored === "dark" || (!stored && prefersDark)) {
                document.documentElement.setAttribute("data-theme", "dark");
            }
        </script>
        <ClientRouter data-jc-id="GWUJ57"/>
    </head>
    <body data-jc-id="GWUJ2J">
        <a class="skip-link" href="#main-content" data-jc-id="GWUJ0Y" data-jc-content="layout.link.skip-to-main-content">Skip to main content</a>

        <Navbar currentPage={currentPage} data-jc-id="GWU2S3"/>

        <main id="main-content" data-jc-id="GWU25T">
            <slot data-jc-id="GWU231"/>
        </main>

        <Footer data-jc-id="GWU1ZR"/>
    </body>
</html>