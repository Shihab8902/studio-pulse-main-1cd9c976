---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="Home" currentPage="home" data-jc-id="R04QOS">
	<section class="section section-hero" aria-labelledby="hero-heading" data-jc-id="R04QLA">
		<div class="container has-text-centered" data-jc-id="R04PX4">
			<p class="tag is-primary is-medium mb-5" data-jc-id="R04PTJ" data-jc-content="home.description.2">Creative Studio</p>
			<h1 id="hero-heading" class="title is-1" data-jc-id="R04P5L" data-jc-content="home.title.2">This update was made from Jellycube</h1>
			<p class="subtitle is-4 mt-4 u-constrained" data-jc-id="R04OEW" data-jc-content="home.text.2.2">Studio Pulse is a full-service communication agency that
				blends creative direction, brand strategy, and digital craft
				to build experiences that demand attention.</p>
			<div class="buttons is-centered mt-6" data-jc-id="R04MUX">
				<a class="button is-primary is-large" href="/contact" data-jc-id="R04MRE" data-jc-content="home.link.start-a-project">Start a project</a>
				<a class="button is-outlined is-large" href="/contact" data-jc-id="R04M2H" data-jc-content="home.link.our-work.2">Our work</a>
			</div>
		</div>
	</section>

	<section class="section has-bg-elevated" aria-labelledby="services-heading" data-jc-id="R04LBT">
		<div class="container" data-jc-id="R04KMV">
			<div class="has-text-centered mb-6" data-jc-id="R04KKY">
				<p class="u-label-overline" data-jc-id="F99OGA" data-jc-content="home.text.3.2">What we do</p>
				<h2 id="services-heading" class="title is-2 mt-3" data-jc-id="F99OKT" data-jc-content="home.heading.everything-your-brand-needs">
					Everything your brand needs,<br data-jc-id="F99PAH"/> under one roof
				</h2>
			</div>
			<ul class="columns is-multiline" data-jc-id="F99PW5">
				<li class="column is-one-third" data-jc-id="F99PZJ">
					<Card title="Brand Strategy" icon="🎯" data-jc-id="F99Q2X">
						Positioning, architecture, and narrative frameworks that
						give your brand clarity and conviction in crowded markets.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="F99RJL">
					<Card title="Creative Direction" icon="✨" data-jc-id="F99S52">
						Visual identity, art direction, and campaign concepts that
						stop the scroll and stick in memory.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="F99T2L">
					<Card title="Digital & Motion" icon="⚡" data-jc-id="F99TO2">
						Websites, apps, and motion design built for performance,
						crafted to feel as good as they look.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="F99V30">
					<Card title="Content & Social" icon="📣" data-jc-id="F99V6E">
						Editorial strategy, copywriting, and social campaigns
						that turn audiences into communities.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="F9AC5V">
					<Card title="UX & Product Design" icon="📐" data-jc-id="F9AC99">
						Research-driven interfaces, design systems, and prototypes
						that ship fast and scale gracefully.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="F9ADOX">
					<Card title="Video Production" icon="🎬" data-jc-id="F9ADSB">
						From concept to final cut — commercial, branded content,
						and storytelling that moves people.
					</Card>
				</li>
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="cta-heading" data-jc-id="F9AF9R">
		<div class="container has-text-centered" data-jc-id="F9AFWY">
			<p class="tag is-primary is-medium mb-5" data-jc-id="F9AG0J" data-jc-content="home.text.4.2">Let's talk</p>
			<h2 id="cta-heading" class="title is-2" data-jc-id="F9AGNR" data-jc-content="home.heading.ready-to-make-noise">Ready to make noise?</h2>
			<p class="subtitle is-4 mt-3 u-constrained-sm" data-jc-id="F9AHCO" data-jc-content="home.text.5">The best brands don't whisper. Let's build something that
				gets heard.</p>
			<a class="button is-primary is-large mt-5" href="/contact" data-jc-id="F9AI6Q" data-jc-content="home.link.get-in-touch.3">Get in touch</a>
		</div>
	</section>
</Layout>