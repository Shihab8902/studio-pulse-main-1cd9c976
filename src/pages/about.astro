---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="About Us" currentPage="about" data-jc-id="QH36ZL">
	<section class="section section-hero" aria-labelledby="about-heading" data-jc-id="QH36VY">
		<div class="container has-text-centered" data-jc-id="QH3676">
			<p class="tag is-primary is-medium mb-5" data-jc-id="QH363L" data-jc-content="about.description">About</p>
			<h1 id="about-heading" class="title is-1" data-jc-id="QH35H3" data-jc-content="about.title">We are Studio Pulse</h1>
			<p class="subtitle is-4 mt-4 u-constrained" data-jc-id="QH35A8" data-jc-content="about.text.2">A tight-knit team of strategists, designers, writers,
				and developers obsessed with making brands unforgettable.</p>
		</div>
	</section>

	<section class="section has-bg-elevated" aria-labelledby="story-heading" data-jc-id="QH33SY">
		<div class="container" data-jc-id="QH3343">
			<div class="columns is-vcentered" data-jc-id="QH3326">
				<div class="column is-half" data-jc-id="QH32GO">
					<p class="u-label-overline mb-3" data-jc-id="QH32DE" data-jc-content="about.text.3">Our story</p>
					<h2 id="story-heading" class="title is-2" data-jc-id="QH31Q0" data-jc-content="about.heading.born-from-the-belief">Born from the belief that great communication changes everything</h2>
				</div>
				<div class="column is-half" data-jc-id="QH30VV">
					<div class="content is-medium" data-jc-id="VNLN3U">
						<p data-jc-id="VNLN78" data-jc-content="about.text.4">Studio Pulse was founded on a simple conviction: every brand
							has a story worth telling, and telling it well is the difference
							between being seen and being remembered.</p>
						<p data-jc-id="VNLOPG" data-jc-content="about.text.5">We bring together strategic rigor and creative fire. No filler,
							no templates — just sharp thinking and meticulous craft, tailored
							to the people you're trying to reach.</p>
						<p data-jc-id="VNLQ7P" data-jc-content="about.text.6">From startups finding their voice to established brands rewriting
							their narrative, we partner with ambitious teams who refuse to blend in.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="principles-heading" data-jc-id="VNLRRI">
		<div class="container" data-jc-id="VNLSEW">
			<div class="has-text-centered mb-6" data-jc-id="VNLSHE">
				<p class="u-label-overline" data-jc-id="VNLT2Y" data-jc-content="about.text.7">How we work</p>
				<h2 id="principles-heading" class="title is-2 mt-3" data-jc-id="VNLT83" data-jc-content="about.heading.principles-we-live-by">Principles we live by</h2>
			</div>
			<ul class="columns is-multiline" data-jc-id="VNLTYV">
				<li class="column is-one-third" data-jc-id="VNMA4X">
					<Card title="Craft over volume" data-jc-id="VNMA8B">
						We take on fewer projects so we can go deeper. Every pixel,
						every word, every frame matters.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="VNMBME">
					<Card title="Strategy drives creative" data-jc-id="VNMBPS">
						Beautiful work without thinking behind it is decoration.
						We anchor every idea in insight.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="VNMD4K">
					<Card title="No egos, just outcomes" data-jc-id="VNMD7Y">
						Ideas win on merit. We check titles at the door and
						rally around the best path forward.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="VNMEM1">
					<Card title="Ship, learn, iterate" data-jc-id="VNMEPF">
						Perfectionism kills momentum. We bias toward action,
						measure real results, and refine relentlessly.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="VNMG4D">
					<Card title="Radical transparency" data-jc-id="VNMG7R">
						Clients see everything: timelines, work-in-progress,
						challenges. Trust is built in the open.
					</Card>
				</li>
				<li class="column is-one-third" data-jc-id="VNMX73">
					<Card title="Long-term partnership" data-jc-id="VNMXAH">
						We're not a one-and-done agency. We invest in
						relationships that grow with every collaboration.
					</Card>
				</li>
			</ul>
		</div>
	</section>
</Layout>